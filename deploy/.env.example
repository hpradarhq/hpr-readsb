# Copy to deploy/.env and keep it local. Do not commit real station UUIDs/coordinates.

FEEDER_TZ=Asia/Ho_Chi_Minh
ADSB_SDR_SERIAL=
ADSB_SDR_PPM=0

FEEDER_LAT=
FEEDER_LONG=
FEEDER_ALT_M=
FEEDER_ALT_FT=
FEEDER_NAME=

MULTIFEEDER_UUID=
ADSBX_UUID=

FEEDER_HEYWHATSTHAT_ID=
FEEDER_HEYWHATSTHAT_ALTS=3000,10000,30000,40000

# HPR readsb tuning.
READSB_GAIN=auto
READSB_MAX_RANGE_NM=
READSB_JSON_INTERVAL=1

# Optional central HPR feed.
HPR_UPSTREAM_HOST=
HPR_UPSTREAM_PORT=30004
