# Copy this file to .env and edit only what you need.

# Stable station / receiver UUID. Generate once with:
# cat /proc/sys/kernel/random/uuid
HPR_FEEDER_UUID=

# Optional: push BeastReduce+UUID to central HPR Atlas/readsb ingest.
HPR_UPSTREAM_HOST=
HPR_UPSTREAM_PORT=30004

# Optional receiver position. Recommended for local CPR/range display.
RECEIVER_LAT=
RECEIVER_LON=

# readsb edge tuning.
READSB_GAIN=auto
READSB_MAX_RANGE_NM=
READSB_JSON_INTERVAL=1
